# Settings for selfhost-remote-mail-mcp. Copy to .env and fill in.
# Every setting is explained in docs/settings.md. Never share or commit your real .env.

# --- Mailboxes: add them on the settings page (/settings). The lines below are only for setting one here instead;
# then the page can't change or remove it. docs/mailboxes.md ---
# MAIL_ADDRESS=you@example.com
# MAIL_PASSWORD=
# IMAP_HOST=imap.example.com
# SMTP_HOST=smtp.example.com
# MAIL_NAME=Your Name
# MAIL_LABEL=Work            a short name for this mailbox
# MAIL_MODE=full             full, draft (never sends) or read (read only)
# MAIL_USERNAME=          only if your login name isn't your email address
# SMTP_USERNAME=          only if sending needs a different login name (iCloud sometimes)
# IMAP_PORT=993
# 465 = SSL from the start, 587 = STARTTLS
# SMTP_PORT=465
# The default mailbox (else the settings page's Make default, else the first one)
# MAIL_DEFAULT=you@example.com

# --- More mailboxes (up to 5). Missing servers and ports are copied from mailbox 1. docs/mailboxes.md ---
# MAIL_2_ADDRESS=you@gmail.com
# MAIL_2_PASSWORD=
# MAIL_2_IMAP_HOST=imap.gmail.com
# MAIL_2_SMTP_HOST=smtp.gmail.com
# MAIL_2_MODE=draft
# MAIL_2_LABEL=Personal

# --- Settings page (/settings) ---
# SETTINGS_PAGE=on
# The settings page's list of devices and 7-day sign-in history (can also be turned off on the page)
# DEVICE_LOG=on
# Encrypts passwords of mailboxes added on the settings page. Use a long random value.
# MAIL_SECRET_KEY=

# --- Attachments (docs/attachments.md) ---
# ATTACH_MAX_MB=25
# AI apps on this computer: folders files may be attached from (hidden files never are)
# ATTACH_FOLDERS=~
# The upload page (/upload)
# UPLOAD_PAGE=on
# Remove location from attached photos, and author details from attached documents
# REMOVE_PHOTO_LOCATION=on
# REMOVE_DOCUMENT_DETAILS=on
# One-time upload links for files dropped into the AI chat
# UPLOAD_LINKS=on

# --- Language of the web pages (docs/languages.md); empty = follow the browser ---
# LANGUAGE=de

# --- Add-ons (docs/addons.md) ---
# MAIL_ADDONS=calendar_invite

# --- Passphrase: the settings page and logins from the internet (phone, claude.ai, ChatGPT) ---
# At least 12 characters. Or run `selfhost-remote-mail-mcp set-passphrase` to store only a hash (LOGIN_HASH).
LOGIN_PASSPHRASE=
# The public https address of this server. Render and Railway fill this in for you.
# PUBLIC_URL=https://mail.example.com
# Only for docker-compose.yml (option 3): your domain, without https://
# MAIL_DOMAIN=mail.example.com

# --- Safety limits ---
SEND_DAILY_LIMIT=40
SEND_MINUTE_LIMIT=3
# on/off: send emails scheduled with schedule_send (serve mode only). off on a second copy that shares the mailboxes
SCHEDULED_SEND=on
# on/off: add-ons that work in the background (serve mode only). off on a second copy that shares the mailboxes
# ADDON_JOBS=on

# --- Safety and privacy (docs/settings.md) ---
# on = read and search only, nothing can be changed or sent
MAIL_READ_ONLY=off
# Only send to these addresses and @domains (comma separated). Empty = anyone.
# SEND_ALLOWED_RECIPIENTS=me@example.com,@mycompany.com
# on = also log recipients and subjects (off keeps only times and counts)
SEND_LOG_DETAILS=off

# --- Older way to add one read-only mailbox (still works; MAIL_2_MODE=read is the new way) ---
# READ_ONLY_ADDRESS=
# READ_ONLY_PASSWORD=

# --- Time zone used in the send log and in times shown to you (e.g. Europe/London, America/New_York) ---
# Must be a real environment variable (or hosting variable); this file can't set it.
# TZ=UTC

# --- More options (docs/settings.md) ---
# UPDATE_CHECK=off
# Before 0.18 the one signature for every mailbox. Now each mailbox has its own on the settings page;
# a value here is copied to every mailbox once.
# MAIL_SIGNATURE=Your Name\nYour title
# MAX_MAILBOXES=5
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com,vscode.dev
# HOST=127.0.0.1
# PORT=8765
# MAIL_ADDONS_DIR=
# READ_ONLY_USERNAME=
# MAIL_2_NAME=
# MAIL_2_USERNAME=
